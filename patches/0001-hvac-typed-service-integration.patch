+    private fun isTypedHvacTemperatureCommand(command: VoiceCommand): Boolean = when (command) {
+        is VoiceCommand.SetTemperature,
+        is VoiceCommand.AdjustTemperature,
+        VoiceCommand.TemperatureHigh,
+        VoiceCommand.TemperatureLow -> true
+        is VoiceCommand.Window -> false
+    }
+
+    private fun executeTypedHvacCommand(parsed: com.voicegeely.app.voice.ParsedVoiceCommand): Boolean {
+        val helper = vehiclePropertyHelper
+        if (helper == null) {
+            lastCommandRequiresVehicle = true
+            return true
+        }
+
+        Log.i(TAG, "[VOICE_FLOW][HVAC] ACK -> EXECUTE -> VERIFY -> RESULT command=${parsed.command}")
+        val coordinator = VoiceCommandCoordinator(
+            executor = HvacVoiceCommandExecutor(helper),
+            speech = VoiceSpeechSink { text ->
+                if (ttsReady && text.isNotBlank()) {
+                    carAudioPlayer.playText(text)
+                }
+            }
+        )
+
+        val result = runBlocking {
+            coordinator.handle(parsed, VoiceResponseMode.FULL)
+        }
+
+        lastTemperatureUnconfirmed = result is CommandExecutionResult.AcceptedUnverified
+        if (helper.isMock && result is CommandExecutionResult.Confirmed) {
+            lastCommandUsedMockVhal = true
+        }
+
+        return when (result) {
+            is CommandExecutionResult.Confirmed -> true
+            is CommandExecutionResult.AcceptedUnverified -> true
+            is CommandExecutionResult.Rejected -> false
+            is CommandExecutionResult.Failed -> false
+        }
+    }
