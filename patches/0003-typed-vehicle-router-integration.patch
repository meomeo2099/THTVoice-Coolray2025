@@
+import com.voicegeely.app.voice.CommandExecutionResult
+import com.voicegeely.app.voice.LegacyPredictionBridge
+import com.voicegeely.app.voice.VehicleCommandRouter
+import com.voicegeely.app.voice.VoiceCommandCoordinator
+import com.voicegeely.app.voice.VoiceCommandParser
+import com.voicegeely.app.voice.VoiceResponseMode
+import com.voicegeely.app.voice.VoiceSpeechSink
+import kotlinx.coroutines.runBlocking
@@
-        val prediction = intentModel.predict(parsedText)
+        val typed = VoiceCommandParser.parse(parsedText)
+        if (typed != null) {
+            val helper = vehiclePropertyHelper
+            if (helper != null) {
+                val coordinator = VoiceCommandCoordinator(
+                    executor = VehicleCommandRouter(helper),
+                    speech = VoiceSpeechSink { text ->
+                        if (ttsReady && text.isNotBlank()) carAudioPlayer.playText(text)
+                    }
+                )
+                val result = runBlocking { coordinator.handle(typed, VoiceResponseMode.FULL) }
+                return when (result) {
+                    is CommandExecutionResult.Confirmed -> true
+                    is CommandExecutionResult.AcceptedUnverified -> true
+                    is CommandExecutionResult.Rejected -> false
+                    is CommandExecutionResult.Failed -> false
+                }
+            }
+
+            // Keep the compatibility bridge only when a typed command exists but
+            // the vehicle backend has not been initialized yet.
+            val bridged = LegacyPredictionBridge.toPayload(typed)
+            val prediction = PredictionResult(
+                text = bridged.originalText,
+                normalizedText = bridged.normalizedText,
+                intent = bridged.intent,
+                confidence = 1f,
+                entities = bridged.entities
+            )
+            return handlerRegistry.handle(prediction)
+        }
+
+        val prediction = intentModel.predict(parsedText)
